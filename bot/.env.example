# Copia questo file in bot/.env e riempi i valori. bot/.env NON va nel repository (.gitignore).
# Sul VPS bot/.env arriva dal PC via scp (deploy/DEPLOY.md, passo 3), mai da GitHub.
BOTBTC_TELEGRAM_TOKEN=
BOTBTC_TELEGRAM_CHAT_ID=

# Facoltativi: sovrascrivono i valori di bot/config.py
# BOTBTC_BUDGET_EUR=200
# BOTBTC_TETTO_MESI=

# Messaggi a sorpresa: il polso N volte a settimana, a un'ora casuale (0 = spenti)
# BOTBTC_SORPRESE_SETTIMANA=3
# BOTBTC_SORPRESE_ORE=10-18
# BOTBTC_SORPRESE_FERIALI=1

# /ai_commentary al giorno per ogni persona autorizzata (il proprietario non ha limiti; 0 = nessun limite)
# BOTBTC_AI_AL_GIORNO=1
